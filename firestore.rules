rules_version = '2';

// Security rules for Lore. Deploy with:  npx firebase-tools deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /artifacts/{appId} {

      // ---------- Private per-user data ----------
      match /users/{uid} {
        // tasks, schedule, notes, goals, transactions, workouts,
        // private_diaries, ai_therapist_chat, settings/profile
        match /{collection}/{docId} {
          allow read, write: if isMe(uid);
        }

        // Friends list: the owner manages it. Someone else may add *themselves*
        // only after accepting a friend request this user sent them.
        match /friends/{friendUid} {
          allow read, delete: if isMe(uid);
          allow create, update: if isMe(uid)
            || (isMe(friendUid)
                && request.resource.data.uid == friendUid
                && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/friend_requests/$(uid + '_' + friendUid)).data.status == 'accepted');
        }
      }

      // ---------- Shared / social data ----------
      match /public/data {

        // Public profile card (name, avatar, friend code, bio).
        match /user_directory/{uid} {
          allow read: if signedIn();
          allow write: if isMe(uid);
        }

        // Diaries shared with friends: only the author and the author's
        // friends can see, like or comment on them.
        match /public_diaries/{postId} {
          function isAuthor() {
            return signedIn() && resource.data.authorUid == request.auth.uid;
          }
          function isAuthorsFriend() {
            return signedIn() && exists(
              /databases/$(database)/documents/artifacts/$(appId)/users/$(resource.data.authorUid)/friends/$(request.auth.uid)
            );
          }
          allow read: if isAuthor() || isAuthorsFriend();
          allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
          allow delete: if isAuthor();
          allow update: if isAuthor()
            || (isAuthorsFriend() && onlyChanges(['likes', 'comments']));
        }

        match /friend_requests/{reqId} {
          allow read: if signedIn()
            && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
          allow get: if signedIn() && reqId.matches('^' + request.auth.uid + '_.*');
          allow create: if signedIn()
            && request.resource.data.fromUid == request.auth.uid
            && reqId == request.auth.uid + '_' + request.resource.data.toUid
            && request.resource.data.status == 'pending';
          allow update: if signedIn()
            && resource.data.toUid == request.auth.uid
            && onlyChanges(['status']);
          allow delete: if signedIn()
            && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
        }

        match /shared_goals/{goalId} {
          allow read: if signedIn()
            && (resource.data.ownerUid == request.auth.uid || resource.data.partnerUid == request.auth.uid);
          allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
          allow update: if signedIn() && (
            (resource.data.ownerUid == request.auth.uid && onlyChanges(['ownerProgress', 'title']))
            || (resource.data.partnerUid == request.auth.uid && onlyChanges(['partnerProgress']))
          );
          allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
        }

        match /direct_messages/{msgId} {
          allow read: if signedIn()
            && (resource.data.senderUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);
          allow create: if signedIn() && request.resource.data.senderUid == request.auth.uid;
          allow delete: if signedIn() && resource.data.senderUid == request.auth.uid;
        }
      }
    }

    // Top-level likes/comments used by the helpers in firebase.js.
    match /likes/{likeId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.user == request.auth.uid
        && likeId == request.auth.uid + '_' + request.resource.data.post;
      allow delete: if signedIn() && resource.data.user == request.auth.uid;
    }
    match /comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.user == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.user == request.auth.uid;
    }
  }
}
